# Copy to .env — `./script/setup` does this for you.
DATABASE_URL="postgresql://zizzu:zizzu@db:5432/zizzu"

# Used by `npm test`. Must be a DIFFERENT database from DATABASE_URL: the test
# suite empties every table before each test.
TEST_DATABASE_URL="postgresql://zizzu:zizzu@localhost:5432/zizzu_test"
