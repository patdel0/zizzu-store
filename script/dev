#!/usr/bin/env sh

# Starts the containers *and* syncs your edits into the app container, which is
# what you want while you are working. Runs in the foreground: leave it open.
#
# `script/server` is the detached version, for when you just need the app up.

docker compose up -d

# The app's database needs its tables before anything can read from it, and
# `db init` only ever adds what is missing, so this is safe to run every time.
# Without it `/api/posts` answers 500 and `/posts` shows an error, which is a
# baffling first impression of a project that is working fine.
docker compose exec -T app npx prisma-cli db init --no-interactive --yes >/dev/null 2>&1 \
  || echo "Could not initialise the database. Try: docker compose exec app npx prisma-cli db init"

docker compose watch
